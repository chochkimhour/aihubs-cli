    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prettier": "^3.9.6",
    "typescript": "^5.7.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chochkimhour/vibecode-cli"
  }
